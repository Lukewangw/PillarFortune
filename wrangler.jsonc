{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pillarfortune",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The Vite build is served as static assets; only /api/* reaches the Worker.
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "TAROT_SESSION", "class_name": "TarotSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TarotSession"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-ai-pillarfortune-db",
      "database_id": "f4a7d315-4404-4f66-a5ae-9872b7277ba7",
      "migrations_dir": "worker/migrations"
    }
  ],
  "vars": {
    // "workers-ai" | "fault-injection" (simulated model) | "offline" (knowledge-base composer only)
    "LLM_PROVIDER": "workers-ai",
    "LLM_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // Cost guards: model calls per UTC day (all users), and per-network daily request limits.
    "DAILY_LLM_BUDGET": "300",
    "PER_IP_DAILY_READINGS": "40",
    "PER_IP_DAILY_FOLLOWUPS": "150",
    "ALLOWED_ORIGINS": "*"
  }
}
