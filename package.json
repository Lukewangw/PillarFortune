{
  "name": "cf_ai_pillarfortune",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Grounded conversational tarot: a verifiable seeded draw engine, a schema-constrained LLM interpreter with validation, bounded retries and fallbacks, and an evaluation harness.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "worker:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "eval": "tsx ml/evals/run.ts",
    "e2e": "playwright test",
    "eval:simulate": "tsx ml/evals/simulate.ts",
    "router:train": "python ml/router/train.py && tsx ml/router/evaluate.ts",
    "smoke": "tsx scripts/smoke-api.ts"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.144.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
